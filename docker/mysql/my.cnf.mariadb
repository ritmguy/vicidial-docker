[mariadb]
port=3306
socket=/tmp/mysql.sock
key_buffer_size=16M
max_allowed_packet=128M
default-authentication-plugin=mysql_native_password
local-infile=1

# Listen on loopback only.
#
# All three services run on one host and share its network namespace
# (network_mode: host), so they reach the database over 127.0.0.1 and need
# nothing else. Without this MariaDB listens on 0.0.0.0 -- and because the
# container shares the host's networking, that means every interface the host
# has, reachable by anything that can route to it.
#
# This is the BUILD-TIME default. It is overridden at runtime by the db
# service's `command:` in docker-compose.yaml, which reads VICI_DB_BIND from
# .env. To allow remote dialers, set VICI_DB_BIND there -- do not edit this
# file, and do not simply switch to 0.0.0.0. See "Database exposure" in
# docs/USAGE.md.
bind-address=127.0.0.1
